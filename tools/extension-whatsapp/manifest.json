{
  "manifest_version": 3,
  "name": "TOP TV - WhatsApp Bridge",
  "version": "1.2.0",
  "description": "Ponte de automação de cobrança entre o painel TOP TV e o WhatsApp Web",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://web.whatsapp.com/*",
    "*://*.lovable.app/*",
    "http://localhost:*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.lovable.app/*",
        "http://localhost:*/*"
      ],
      "js": [
        "panel-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp-content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}